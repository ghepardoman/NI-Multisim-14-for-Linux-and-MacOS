#!/bin/sh
# Multisim 14.3 desktop launcher -- Wayland native first, X11 fallback.
#
# Wine 11+ ships winewayland.drv: when a Wayland compositor socket is
# reachable the windows composite straight onto the real desktop (no Xephyr,
# no XWayland round trip). Some Wine builds / compositors still need X11, so
# the fallback keeps the classic DISPLAY path working unchanged.
#
# Priority:
#   1. X11      -- DISPLAY as-is (Xorg session or XWayland). The default:
#                  winewayland.drv currently misrenders this app's GDI/MDI
#                  surface (content smaller than the window frame, mouse
#                  offset).
#   2. Wayland  -- opt in via MULTISIM_FORCE_BACKEND=wayland (pure-Wayland
#                  session without XWayland).
#
# Override: MULTISIM_FORCE_BACKEND=wayland|x11 picks one explicitly.

set -eu

WINEPREFIX_DEFAULT="$HOME/.multisim143"
export WINEPREFIX="${WINEPREFIX:-$WINEPREFIX_DEFAULT}"
XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR

force="${MULTISIM_FORCE_BACKEND:-}"

want_wayland() {
  [ -n "${WAYLAND_DISPLAY:-}" ] && return 0
  [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && return 0
  return 1
}

case "$force" in
  wayland)
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
    unset DISPLAY
    ;;
  x11)
    : "${DISPLAY:?MULTISIM_FORCE_BACKEND=x11 but DISPLAY is not set}"
    ;;
  "")
    # Default stays X11/XWayland: winewayland.drv currently misreports the
    # client surface size for this app (GDI/BCGControlBar MDI) — the window
    # frame is full-size but the rendered content is smaller and input
    # coordinates drift (observed on KDE Plasma 1920x1080 scale=1). Keep
    # DISPLAY as-is; wayland users can opt in with MULTISIM_FORCE_BACKEND=wayland.
    ;;
  *)
    echo "multisim143-launch: unknown MULTISIM_FORCE_BACKEND '$force'" >&2
    exit 2
    ;;
esac

if [ "$(uname -s)" = "Darwin" ]; then
  open -a Multisim
  exit 0
fi

exec wine "C:\\users\\$USER\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NI Multisim 14.3.lnk"
