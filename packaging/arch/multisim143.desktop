[Desktop Entry]
Type=Application
Name=NI Multisim 14.3
GenericName=Circuit Simulator
Comment=SPICE circuit design and simulation, running under Wine (first launch installs it)
Exec=multisim143 %f
Icon=multisim143
Terminal=false
Categories=Education;Engineering;Science;
Keywords=circuit;spice;simulation;electronics;eda;multisim;
StartupNotify=true
StartupWMClass=multisim.exe
